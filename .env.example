# Kopiér til .env og udfyld. .env må aldrig committes.

# Sikkerhed
SECRET_KEY=skift-denne-til-noget-tilfaeldigt
DASHBOARD_PASSWORD=skift-denne
POSTGRES_PASSWORD=skift-denne

# Alpaca paper konto (hent på https://app.alpaca.markets)
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Alpaca live konto. Udfyldes FØRST når paper gate er bestået.
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALLOW_LIVE_TRADING=false

# Handelsunivers, kommasepareret
# UNIVERSE=AAPL,MSFT,NVDA

# Notifikationer via Telegram (valgfrit)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
